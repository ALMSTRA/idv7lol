        "max": 9000,
        "scale": 1,
        "offset": 0,
        "clamp": true,
        "smoothing": 0.05,
        "fallback": "dash"
      },
      "animations": [],
      "type": "gauge.arc",
      "props": {
        "startAngle": 190,
        "sweepAngle": 160,
        "track": {
          "show": true,
          "color": "$track",
          "width": 44,
          "cap": "butt"
        },
        "fill": {
          "show": true,
          "color": "$band",
          "width": 44,
          "mode": "segments",
          "segments": 120,
          "segmentGap": 0.6,
          "cap": "butt",
          "zones": [
            {
              "from": 7500,
              "to": 9000,
              "color": "$danger"
            }
          ]
        },
        "ticks": {
          "major": 9,
          "minor": 4,
          "majorLength": 14,
          "minorLength": 7,
          "majorWidth": 3,
          "minorWidth": 1.5,
          "color": "$text",
          "minorColor": "$text-muted",
          "inset": 0,
          "redlineColor": "$danger"
        },
        "labels": {
          "show": true,
          "every": 1,
