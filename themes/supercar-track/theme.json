            "font": "default",
            "size": 48,
            "weight": "bold",
            "color": "$text",
            "align": "center",
            "baseline": "middle",
            "letterSpacing": 0,
            "uppercase": false
          },
          "divisor": 1000,
          "format": "0",
          "inset": 29
        },
        "needle": {
          "show": false,
          "color": "$accent",
          "width": 6,
          "length": 0.9,
          "tail": 0.1,
          "shape": "tapered",
          "cap": {
            "show": true,
            "radius": 14,
            "color": "$surface"
          }
        },
        "redline": {
          "show": true,
          "from": 7500,
          "color": "$danger",
          "width": 10,
          "placement": "outer"
        },
        "valueText": {
          "show": false,
