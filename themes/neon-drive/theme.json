  "animations": {
    "spin": {
      "name": "Spin",
      "duration": 16000,
      "easing": "linear",
      "loop": true,
      "direction": "normal",
      "tracks": [
        {
          "property": "rotation",
          "keyframes": [
            {
              "t": 0,
              "value": 0
            },
            {
              "t": 1,
              "value": 360
            }
          ]
        }
      ]
    },
    "spin-back": {
      "name": "Spin back",
      "duration": 11000,
      "easing": "linear",
      "loop": true,
      "direction": "normal",
      "tracks": [
        {
          "property": "rotation",
          "keyframes": [
            {
              "t": 0,
              "value": 360
            },
            {
              "t": 1,
              "value": 0
            }
          ]
        }
      ]
    },
    "spin-slow": {
      "name": "Spin slow",
      "duration": 40000,
      "easing": "linear",
      "loop": true,
      "direction": "normal",
      "tracks": [
        {
          "property": "rotation",
          "keyframes": [
            {
              "t": 0,
              "value": 0
            },
            {
              "t": 1,
              "value": 360
            }
          ]
        }
      ]
    },
    "glitch": {
      "name": "Glitch",
      "duration": 140,
      "easing": "step",
      "loop": true,
      "direction": "alternate",
      "tracks": [
        {
          "property": "props.valueStyle.color",
          "keyframes": [
            {
              "t": 0,
              "value": "$accent"
            },
            {
              "t": 1,
              "value": "$hot"
            }
          ]
        }
      ]
    },
    "redline": {
      "name": "Redline",
      "duration": 200,
      "easing": "ease-in-out",
      "loop": true,
      "direction": "alternate",
      "tracks": [
        {
          "property": "props.fill.color",
          "keyframes": [
            {
              "t": 0,
              "value": "$danger"
            },
            {
              "t": 1,
              "value": "$hot"
            }
          ]
        }
      ]
    },
    "alarm": {
      "name": "Alarm",
      "duration": 260,
      "easing": "ease-in-out",
      "loop": true,
      "direction": "alternate",
      "tracks": [
        {
          "property": "props.style.color",
          "keyframes": [
            {
              "t": 0,
              "value": "$danger"
            },
            {
              "t": 1,
              "value": "$accent"
            }
          ]
        }
      ]
    },
    "breathe": {
      "name": "Breathe",
      "duration": 2600,
      "easing": "ease-in-out",
      "loop": true,
      "direction": "alternate",
      "tracks": [
        {
          "property": "props.style.color",
          "keyframes": [
            {
              "t": 0,
              "value": "$text-muted"
            },
            {
              "t": 1,
              "value": "$accent"
            }
          ]
        }
      ]
    },
    "shift": {
      "name": "Shift",
      "duration": 380,
      "easing": "ease-out",
      "loop": false,
      "direction": "normal",
      "tracks": [
        {
          "property": "props.style.color",
          "keyframes": [
            {
              "t": 0,
              "value": "$accent"
            },
            {
              "t": 1,
              "value": "$hot"
