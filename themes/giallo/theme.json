{
  "schemaVersion": 1,
  "id": "idv7lol-giallo",
  "name": "IDV7LOL Giallo",
  "version": "0.1.0",
  "author": "idv7lol contributors",
  "description": "A yellow rev counter in the middle with the speed and the gear on two dark panels over it, a map window and trip readings on the left, tyre pressures and temperatures on the right, and a carbon band along the bottom. The Nero palette turns the dial dark.",
  "license": "GPL-3.0-or-later",
  "target": {
    "platform": "idrive7-mgu",
    "display": "kombi-id7-12.3",
    "renderer": "cluster-render"
  },
  "vehicleProfile": "turbo-ice",
  "layout": {
    "width": 1920,
    "height": 720,
    "background": "$background",
    "reservedZones": [
      {
        "id": "cowl",
        "name": "Top cowl (factory telltales)",
        "kind": "factory",
        "x": 730,
        "y": 0,
        "width": 460,
        "height": 128
      },
      {
        "id": "gear-bracket",
