    "default": "giallo",
    "byDriveMode": {},
    "allowManual": true
  },
  "fonts": {
    "default": {
      "family": "sans"
    }
  },
  "assets": {
    "carbon": {
      "type": "image",
      "name": "Carbon band",
      "data": "data:image/png;base64,"
    }
  },
  "animations": {},
  "components": [
    {
      "id": "bg",
      "name": "Background",
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": 1920,
      "height": 720,
      "locked": true,
      "props": {
        "fill": "$background"
      }
    },
    {
      "id": "carbon",
      "name": "Carbon band",
      "type": "image",
      "x": 0,
      "y": 548,
      "width": 1920,
      "height": 172,
      "locked": true,
      "props": {
        "asset": "carbon",
        "fit": "stretch"
      }
    },
    {
      "id": "map",
      "name": "Map window",
      "type": "map",
      "x": 150,
      "y": 250,
      "width": 250,
      "height": 290,
      "props": {
        "fill": "$map",
        "radius": 8,
        "stroke": {
          "color": "$panel-edge",
          "width": 1
        }
      }
    },
    {
      "id": "left-panel",
      "name": "Left panel",
      "type": "rect",
      "x": 412,
      "y": 234,
      "width": 340,
      "height": 314,
      "props": {
        "fill": {
          "type": "linear",
          "angle": 90,
          "stops": [
            {
              "offset": 0,
              "color": "$panel"
            },
            {
              "offset": 1,
              "color": "$panel-low"
            }
          ]
        },
        "radius": 8,
        "stroke": {
          "color": "$panel-edge",
          "width": 1
        }
      }
    },
    {
      "id": "tab-left",
      "name": "Driving mode tab",
      "type": "text",
      "x": 426,
      "y": 192,
      "width": 290,
      "height": 30,
      "binding": {
        "signal": "drive.mode",
        "fallback": "hide"
      },
      "props": {
        "text": "{value}",
        "style": {
          "size": 21,
          "weight": "medium",
          "color": "$accent",
          "align": "left",
          "baseline": "middle",
          "letterSpacing": 2,
          "uppercase": true
        }
      }
    },
    {
      "id": "tab-line",
      "name": "Tab line",
      "type": "line",
      "x": 412,
      "y": 226,
      "width": 1096,
      "height": 2,
      "props": {
        "stroke": {
          "color": "$accent",
          "width": 2
        },
        "direction": "horizontal"
      }
    },
    {
      "id": "trip",
      "name": "Trip readings",
      "type": "status.panel",
      "x": 426,
      "y": 256,
      "width": 270,
      "height": 190,
      "props": {
        "rows": [
          {
            "label": "Trip",
            "binding": {
              "signal": "vehicle.trip.distance"
            },
            "format": "0.0",
            "unit": "km",
            "showUnit": true
          },
          {
            "label": "Average",
            "binding": {
              "signal": "fuel.consumption.average"
            },
            "format": "0.0",
            "unit": "l_100km",
            "showUnit": true
          },
          {
            "label": "Range",
            "binding": {
              "signal": "vehicle.range"
            },
            "format": "0",
            "unit": "km",
            "showUnit": true
          }
        ],
        "rowHeight": 60,
        "labelStyle": {
          "size": 19,
          "weight": "regular",
          "color": "$text-muted",
          "align": "left",
          "baseline": "middle"
        },
        "valueStyle": {
          "size": 26,
          "weight": "medium",
          "color": "$text",
          "align": "right",
          "baseline": "middle"
        },
        "unitStyle": {
          "size": 16,
          "weight": "regular",
          "color": "$text-muted",
          "align": "right",
          "baseline": "middle"
        },
        "padding": 4,
        "divider": {
          "show": true,
          "color": "$panel-edge"
        }
      }
    },
    {
      "id": "warmup",
      "name": "Warm-up",
