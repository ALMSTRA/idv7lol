      "x": 0,
      "y": 0,
      "width": 1920,
      "height": 720,
      "props": {
        "fill": {
          "type": "linear",
          "angle": 90,
          "stops": [
            {
              "offset": 0,
              "color": "$bg-top"
            },
            {
              "offset": 1,
              "color": "$background"
            }
          ]
        }
      },
      "name": "Background",
      "locked": true
