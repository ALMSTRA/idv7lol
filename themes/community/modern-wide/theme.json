    {
      "id": "speed-bar",
      "type": "gauge.bar",
      "x": 200,
      "y": 136,
      "width": 28,
      "height": 488,
      "binding": {
        "signal": "vehicle.speed",
        "min": 0,
        "max": 260,
        "smoothing": 0.06
      },
      "props": {
        "orientation": "vertical",
        "track": {
          "color": "$track",
          "radius": 3
        },
        "fill": {
          "color": {
            "type": "linear",
            "angle": 270,
            "stops": [
              {
                "offset": 0,
                "color": "$fill-low"
              },
              {
                "offset": 1,
                "color": "$fill-high"
              }
            ]
          },
          "radius": 2,
          "mode": "segments",
          "segments": 44,
          "segmentGap": 4,
          "zones": []
        },
        "ticks": {
          "show": true,
          "count": 14,
          "color": "$tick",
          "length": 8,
          "width": 2,
          "side": "after"
        },
        "labels": {
          "show": true,
          "divisor": 1,
          "style": {
            "size": 22,
            "color": "$numeral",
            "align": "center",
            "baseline": "middle"
          },
          "offset": 34
        },
        "glow": {
          "show": true,
          "color": "$fill-high",
          "blur": 12
        }
      },
      "name": "Speed bar"
    },
