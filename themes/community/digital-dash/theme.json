{
  "schemaVersion": 1,
  "id": "digital-dash",
  "name": "Digital Dash",
  "version": "0.1.0",
  "author": "eroobeeroo (eroobeeroo/idrive7-cluster-info), converted to idv7lol",
  "description": "Conversion to idv7lol of \"Digital dash\" from eroobeeroo/idrive7-cluster-info by eroobeeroo, GPL-3.0-or-later. No dials, all digits and bars: a segmented rpm bar, large speed, battery power, six temperature and boost tiles, and the gear with the charge, electric and fuel ranges.",
  "license": "GPL-3.0-or-later",
  "target": {
    "platform": "idrive7-mgu",
    "display": "kombi-id7-12.3",
    "renderer": "cluster-render"
  },
  "vehicleProfile": "phev",
  "layout": {
    "width": 1920,
    "height": 720,
    "background": "$background",
    "reservedZones": [
      {
        "id": "cowl",
        "name": "Top cowl (factory telltales)",
