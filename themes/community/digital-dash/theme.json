  "palette": {
    "default": "comfort",
    "byDriveMode": {
      "SPORT": "sport",
      "SPORT_PLUS": "sport",
      "TRACK": "sport",
      "ECO_PRO": "efficient"
    },
    "allowManual": true
  },
  "fonts": {
    "default": {
      "family": "sans"
    }
  },
  "assets": {},
  "animations": {},
  "components": [
    {
      "id": "bg",
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": 1920,
      "height": 720,
      "props": {
        "fill": {
          "type": "linear",
          "angle": 90,
          "stops": [
            {
              "offset": 0,
              "color": "$bg-top"
            },
            {
              "offset": 1,
              "color": "$background"
            }
          ]
        }
      },
      "name": "Background",
      "locked": true
    },
    {
      "id": "rpm-bar",
      "type": "gauge.bar",
      "x": 200,
      "y": 138,
      "width": 1520,
      "height": 26,
      "binding": {
        "signal": "engine.rpm",
        "min": 0,
        "max": 8000,
        "smoothing": 0.06
      },
      "props": {
        "track": {
          "color": "$track",
          "radius": 4
        },
        "fill": {
          "color": {
            "type": "linear",
            "angle": 0,
            "stops": [
              {
                "offset": 0,
                "color": "$fill-low"
              },
              {
                "offset": 1,
                "color": "$fill-high"
              }
            ]
          },
          "radius": 3,
          "mode": "segments",
          "segments": 58,
          "segmentGap": 6,
          "zones": [
            {
              "from": 7000,
              "to": 8000,
              "color": "$danger"
            }
          ]
        },
        "marker": {
          "show": true,
          "value": 7000,
          "color": "$danger",
          "width": 3
        },
        "glow": {
          "show": true,
          "color": "$fill-high",
          "blur": 10
        }
      },
      "name": "Engine speed bar"
    },
    {
      "id": "rpm-text",
      "type": "text",
      "x": 200,
      "y": 170,
      "width": 320,
      "height": 24,
      "binding": {
        "signal": "engine.rpm",
        "min": 0,
        "max": 8000,
        "smoothing": 0.06
      },
      "props": {
        "text": "{value} RPM",
        "style": {
          "size": 20,
          "color": "$text-muted",
          "align": "left",
          "baseline": "middle",
          "letterSpacing": 2,
          "weight": "medium"
        },
        "format": "0"
      },
      "name": "Engine speed",
      "visibleWhen": {
        "signal": "engine.running",
        "op": "truthy"
      }
    },
    {
      "id": "rpm-off",
      "type": "text",
      "x": 200,
      "y": 170,
      "width": 320,
      "height": 24,
      "props": {
        "text": "ENGINE OFF",
        "style": {
          "size": 20,
          "color": "$text-muted",
          "align": "left",
          "baseline": "middle",
          "letterSpacing": 2,
          "weight": "medium"
        }
      },
      "name": "Engine off",
      "visibleWhen": {
        "signal": "engine.running",
        "op": "falsy"
      }
    },
    {
      "id": "mode",
      "type": "text",
      "x": 1220,
      "y": 170,
      "width": 500,
      "height": 26,
      "binding": {
        "signal": "drive.mode",
        "fallback": "hide"
      },
      "props": {
        "text": "{value}",
        "style": {
          "size": 24,
          "color": "$accent",
          "align": "right",
          "baseline": "middle",
          "letterSpacing": 5,
          "weight": "bold",
          "uppercase": true
        },
        "format": "0"
      },
      "name": "Driving mode"
    },
    {
      "id": "speed",
      "type": "value.digital",
      "x": 50,
      "y": 196,
      "width": 360,
      "height": 170,
      "binding": {
        "signal": "vehicle.speed",
        "min": 0,
        "max": 260,
        "smoothing": 0.06
      },
      "props": {
        "layout": "inline",
        "format": "0",
        "showUnit": false,
        "valueStyle": {
          "size": 156,
          "color": "$text",
          "align": "center",
          "baseline": "middle",
          "weight": "bold"
        },
        "unitStyle": {
          "size": 156,
          "color": "$text",
          "align": "center",
          "baseline": "middle",
          "weight": "medium"
        },
        "zones": []
