                  "signal": "transmission.gear",
                  "op": "eq",
                  "value": "P"
                },
                {
                  "signal": "transmission.gear",
                  "op": "eq",
                  "value": "R"
                },
                {
                  "signal": "transmission.gear",
                  "op": "eq",
                  "value": "N"
                },
                {
                  "signal": "transmission.gear",
                  "op": "eq",
                  "value": "D"
