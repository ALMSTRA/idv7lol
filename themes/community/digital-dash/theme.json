  "palettes": {
    "comfort": {
      "name": "Comfort",
      "colors": {
        "background": "#020305",
        "surface": "#141e2a",
        "text": "#ffffff",
        "text-muted": "#aebdcc",
        "accent": "#4aa8ff",
        "track": "#1d2835",
        "success": "#3ddc84",
        "warning": "#ffb340",
        "danger": "#ff453a",
        "bg-top": "#0b111a",
        "card-bottom": "#0b121b",
        "edge": "#2c3d51",
        "fill-low": "#2a7fd0",
        "fill-high": "#62c6ff",
        "ev": "#5cbcff"
      }
    },
    "sport": {
      "name": "Sport",
      "colors": {
        "background": "#040202",
        "surface": "#221414",
        "text": "#ffffff",
        "text-muted": "#d4b4ae",
        "accent": "#ff4a3a",
        "track": "#2c1a1a",
        "success": "#3ddc84",
        "warning": "#ffb340",
        "danger": "#ffffff",
