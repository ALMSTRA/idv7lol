        "kind": "keep-clear",
        "x": 0,
        "y": 0,
        "width": 394.54545454545456,
        "height": 217,
        "polygon": [
          {
            "x": 0,
            "y": 0
          },
          {
            "x": 394.54545454545456,
            "y": 0
          },
          {
            "x": 0,
            "y": 217
          }
        ]
      },
      {
        "id": "glass-corner-right",
        "name": "Glass corner (right)",
        "kind": "keep-clear",
        "x": 1525.4545454545455,
        "y": 0,
        "width": 394.54545454545456,
        "height": 217,
        "polygon": [
          {
            "x": 1920,
            "y": 0
          },
          {
            "x": 1525.4545454545455,
            "y": 0
          },
          {
            "x": 1920,
            "y": 217
          }
        ]
      },
      {
        "id": "stock-map-window",
        "name": "Stock map window (slot 0x100)",
        "kind": "info",
        "x": 416,
        "y": 120,
        "width": 1088,
        "height": 480
      }
    ]
