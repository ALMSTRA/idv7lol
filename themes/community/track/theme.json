    {
      "id": "shift-lights",
      "type": "indicator.shiftlights",
      "x": 580,
      "y": 136,
      "width": 760,
      "height": 40,
      "binding": {
        "signal": "engine.rpm",
        "min": 0,
        "max": 8000
      },
      "props": {
        "count": 15,
        "shape": "circle",
        "gap": 24,
        "from": 4500,
        "to": 6700,
        "flashAbove": 6700,
        "flashRateHz": 7,
        "colors": [
          "$success",
          "$success",
          "$success",
          "$success",
          "$success",
          "$success",
          "$success",
          "$warning",
          "$warning",
          "$warning",
          "$warning",
          "$danger",
          "$danger",
          "$danger",
          "$danger"
        ],
        "offColor": "$led-off",
        "symmetric": false,
        "glow": true
      }
    },
    {
      "id": "rpm-bar",
      "type": "gauge.bar",
      "x": 580,
      "y": 188,
      "width": 760,
      "height": 26,
      "binding": {
        "signal": "engine.rpm",
        "min": 0,
        "max": 8000,
        "smoothing": 0.06
      },
      "props": {
        "track": {
          "color": "$track",
          "radius": 4
        },
        "fill": {
          "color": {
            "type": "linear",
            "angle": 0,
            "stops": [
              {
                "offset": 0,
                "color": "$text"
              },
              {
                "offset": 1,
                "color": "$accent"
              }
            ]
          },
          "radius": 3,
          "mode": "segments",
          "segments": 48,
          "segmentGap": 5,
          "zones": [
            {
              "from": 7000,
              "to": 8000,
              "color": "$danger"
            }
          ]
        },
        "marker": {
          "show": true,
          "value": 7000,
          "color": "$danger",
          "width": 3
        }
      },
      "name": "Engine speed bar"
    },
    {
      "id": "gear-card",
      "type": "rect",
      "x": 760,
      "y": 262,
      "width": 400,
      "height": 290,
      "props": {
        "fill": {
          "type": "linear",
          "angle": 90,
          "stops": [
            {
              "offset": 0,
              "color": "$surface"
            },
            {
              "offset": 1,
              "color": "$tile-bottom"
            }
          ]
        },
        "stroke": {
          "color": "$accent",
          "width": 2
        },
        "radius": 14
      },
      "name": "Gear card"
    },
    {
      "id": "gear-mode",
      "type": "text",
      "x": 846,
      "y": 271,
      "width": 114,
      "height": 202,
      "binding": {
        "signal": "transmission.mode",
        "fallback": "hide"
      },
      "props": {
        "text": "{value}",
        "style": {
          "size": 184,
          "color": "$text",
          "align": "center",
          "baseline": "middle",
          "weight": "bold"
        },
        "format": "0"
      },
      "name": "Gear mode letter",
      "visibleWhen": {
        "all": [
          {
            "not": {
              "any": [
                {
                  "signal": "transmission.gear",
                  "op": "eq",
                  "value": "P"
                },
                {
                  "signal": "transmission.gear",
                  "op": "eq",
                  "value": "R"
                },
                {
                  "signal": "transmission.gear",
                  "op": "eq",
                  "value": "N"
                },
                {
                  "signal": "transmission.gear",
                  "op": "eq",
                  "value": "D"
                }
              ]
            }
          },
          {
            "signal": "transmission.gear",
            "op": "truthy"
          }
        ]
      }
    },
