{
  "id": "idv7lol",
  "title": "idv7lol",
  "description": "Your own layout on the whole instrument cluster: themes made with idv7lol Studio, drawn by the cluster itself",
  "version": "0.2.9",
  "startType": "autostart",
  "vendor": "custom",
  "loggingId": "IDV7",
  "iconGlyph": "gauge",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "statusHandBrake": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs",
      "statusInjectionVolume": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "statusStandstillFunctions": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusSwitchDriveDynamicSport2": "rs",
      "statusActualValueTorque2": "rs",
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "statusDSCSwitchHMI": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "_optional": "the gearbox S / M programme (cars without an M/S selector show D) and an M car's engine mode",
      "dataDisplayGearbox": "s",
      "controlDisplayMSystems": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "gearbox oil temperature",
      "basicDataSet": "s"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car's state, so the engine unit is asked for the fuel percentage only while the car is on",
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.KombiIF": {
      "_optional": "the fuel level, the fuel range, the odometer and the trip computer",
      "statusRangeTankStatus": "rs",
      "statusBordcomputerTravelData": "rs",
      "statusBordcomputerAverage": "rs"
    },
    "de.bmw.body.Light": {
      "_optional": "the turn signals, low and high beam and the rear fog light",
      "StatusFunctionsIndicators": "s",
      "LowBeam": "rs",
      "LampExterior": "s",
      "LampExterior2": "s"
    },
    "de.bmw.infotainment.displaydata.DisplayDataServer2": {
      "_optional": "cruise control: on and its set speed",
      "functionalLibraryData": "rs"
    },
    "de.bmw.infotainment.displaydataserver.DisplayDataServer": {
      "_optional": "cruise control on cars that fill the older display data",
      "functionalLibraryData": "rs"
    },
    "de.bmw.chassis.VehicleStabilizationManagement": {
      "_optional": "DSC's raw state on the Signals page and in the log (its values are not decoded yet)",
      "StabilizationManagement": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_optional": "the engine unit's boost and fuel percentage (read only); without it no boost unless the car sends one, and the fuel gauge uses litres over the tank size",
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "idv7lol",
      "buttons": [
        ["BTN_SHOW", "Show on the cluster"],
        ["BTN_DIAG", "Diagnostics"],
        ["BTN_THEME", "Next theme"],
        ["BTN_PALETTE", "Palette"],
        ["BTN_REMOVE", "Remove USB theme"]
      ]
    }
  ],
