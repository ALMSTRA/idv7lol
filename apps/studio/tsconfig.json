{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@idv7lol/theme-schema": ["../../packages/theme-schema/src/index.ts"],
      "@idv7lol/vehicle-signals": ["../../packages/vehicle-signals/src/index.ts"],
      "@idv7lol/theme-engine": ["../../packages/theme-engine/src/index.ts"],
      "@idv7lol/simulator": ["../../packages/simulator/src/index.ts"],
      "@idv7lol/theme-compiler": ["../../packages/theme-compiler/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
