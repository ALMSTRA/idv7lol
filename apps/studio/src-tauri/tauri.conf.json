{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "idv7lol Studio",
  "version": "0.1.0",
  "identifier": "lol.idv7.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "idv7lol Studio",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "idv7lol",
    "shortDescription": "Custom instrument-cluster editor for BMW iDrive 7",
    "longDescription": "Design, simulate, validate and build custom digital cluster layouts for BMW iDrive 7 (MGU) cars.",
    "category": "DeveloperTool",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["idv7theme"],
        "name": "idv7lol theme",
        "description": "idv7lol cluster theme",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": true
      }
    }
  }
}
